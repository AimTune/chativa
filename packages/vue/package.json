{
  "name": "@chativa/vue",
  "version": "0.9.0",
  "description": "Chativa Vue 3 — typed Vue components (ChatIva, ChatBotButton, GenUIMessage), a ChativaPlugin and composables wrapping the Chativa chat widget for Vue 3 / Nuxt 3 apps.",
  "author": "Hamza Agar",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "chativa",
    "chat",
    "vue",
    "vue3",
    "nuxt",
    "web-component",
    "wrapper"
  ],
  "homepage": "https://github.com/AimTune/chativa#readme",
  "bugs": {
    "url": "https://github.com/AimTune/chativa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/chativa.git"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chativa/core": "workspace:*",
    "@chativa/ui": "workspace:*"
  },
  "peerDependencies": {
    "@chativa/core": ">=0.0.1",
    "@chativa/genui": ">=0.0.1",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@chativa/genui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chativa/genui": "workspace:*",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^28.1.0",
    "terser": "^5.46.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.0"
  }
}
