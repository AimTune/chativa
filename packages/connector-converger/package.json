{
  "name": "@chativa/connector-converger",
  "version": "0.0.1",
  "description": "Chativa connector for Converger channel hubs — extends @chativa/connector-mekik with acks, delivery/read receipts, uploads, history paging, reactions and multi-conversation (agent panel) support.",
  "author": "Hamza Agar",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/chativa-converger.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/chativa-converger.global.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "chativa",
    "chat",
    "connector",
    "converger",
    "mekik",
    "websocket",
    "receipts",
    "agent-panel"
  ],
  "homepage": "https://github.com/AimTune/chativa#readme",
  "bugs": {
    "url": "https://github.com/AimTune/chativa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/chativa.git"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.cdn.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chativa/connector-mekik": "workspace:*"
  },
  "peerDependencies": {
    "@chativa/core": ">=0.0.1"
  },
  "devDependencies": {
    "@chativa/core": "workspace:*",
    "@vitest/coverage-v8": "^4.0.18",
    "terser": "^5.46.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  }
}
