    "@chativa/ui": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.3"
  }
