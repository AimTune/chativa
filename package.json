{
  "name": "chativa-workspace",
  "private": true,
  "type": "module",
  "description": "Chativa monorepo — @chativa/core + @chativa/ui",
  "author": "Hamza Agar",
  "license": "MIT",
  "homepage": "https://github.com/AimTune/chativa#readme",
  "bugs": {
    "url": "https://github.com/AimTune/chativa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AimTune/chativa.git"
  },
  "scripts": {
    "dev": "pnpm -F sandbox dev",
    "build": "pnpm -r --filter @chativa/* build",
    "test": "pnpm -r --filter @chativa/* test",
    "test:watch": "pnpm -r --filter @chativa/* exec vitest",
    "test:coverage": "pnpm -r --no-bail --filter @chativa/* run --if-present test:coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "typecheck": "pnpm -r --filter @chativa/* typecheck",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "jsdom":      "^28.1.0",
    "typescript": "~5.8.3",
    "vitest":     "^4.0.18"
  }
}